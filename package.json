{
  "name": "tabby-error-highlight",
  "version": "1.0.0",
  "description": "Tabby terminal plugin to highlight 'Error:' on router console connections",
  "main": "dist/index.js",
  "module": "index.ts",
  "typings": "dist/index.d.ts",
  "type": "commonjs",
  "license": "MIT",
  "author": {
    "name": "Rubén León (kiwinoru)",
    "email": "rubenleon@gmail.com",
    "url": "https://github.com/kiwinoru"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiwinoru/tabby-error-highlight.git"
  },
  "bugs": {
    "url": "https://github.com/kiwinoru/tabby-error-highlight/issues"
  },
  "homepage": "https://github.com/kiwinoru/tabby-error-highlight#readme",
  "keywords": [
    "tabby-plugin",
    "error-highlight",
    "router-console",
    "highlight"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && webpack --progress --color",
    "watch": "webpack --progress --color --watch",
    "deploy": "npm run build && mkdir -p \"$HOME/Library/Application Support/tabby/plugins/node_modules/tabby-error-highlight\" && cp -rf ./dist ./package.json \"$HOME/Library/Application Support/tabby/plugins/node_modules/tabby-error-highlight/\""
  },
  "devDependencies": {
    "@angular/common": "^15.2.10",
    "@angular/core": "^15.2.10",
    "tabby-core": "^1.0.231-nightly.0",
    "tabby-terminal": "^1.0.231-nightly.0",
    "ts-loader": "^9.5.2",
    "typescript": "^4.9.5",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4"
  }
}
